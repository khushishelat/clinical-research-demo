# Trial Check. Copy to .env.local. Every variable is optional in fixture mode.

# fixture (default): recorded research, no API calls. live: real runs on your key.
DEMO_MODE=fixture
PARALLEL_API_KEY=

# Live mode, deployed
PARALLEL_WEBHOOK_SECRET=          # Settings → Webhooks (whsec_…)
PUBLIC_BASE_URL=                  # https://your-deployment, for webhooks
BLOB_READ_WRITE_TOKEN=            # private Vercel Blob; packs, events, job state
UPSTASH_REDIS_REST_URL=           # or KV_REST_API_URL; budgets, rate limits, locks, queue
UPSTASH_REDIS_REST_TOKEN=         # or KV_REST_API_TOKEN
CRON_SECRET=                      # Vercel Cron sends it as a bearer token

# Caps (USD per day unless noted). Viewers never see prices; these protect the key.
RESEARCH_DAILY_BUDGET_USD=15
ASK_DAILY_BUDGET_USD=5
FOLLOWUP_DAILY_BUDGET_USD=2
REFRESH_BUDGET_USD=25             # per weekly refresh day
MAX_RUN_COST_USD=8                # one research run
RESEARCH_PER_IP_PER_DAY=2
ASK_PER_IP_PER_DAY=20
REFRESH_MIN_VIEWS=3               # researched companies join the weekly refresh after this many views
MAX_REFRESHED_COMPANIES=12
