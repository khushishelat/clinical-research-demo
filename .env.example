# Trial Check. Copy to .env.local.

# Needed to build a disease map with the pipeline (scripts/). The app itself
# makes no Parallel calls; it only reads what the pipeline wrote.
PARALLEL_API_KEY=

# Where the pipeline writes and the app reads. Unset: a local folder, .data/
# (gitignored). Set: private Vercel Blob, for a deployment.
BLOB_READ_WRITE_TOKEN=

# Where a clinician can ask to have their profile removed (a mailto: or a form URL).
NEXT_PUBLIC_REMOVAL_URL=
